# n8n API (n8n → Settings → n8n API → Create API key)
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-api-key-here

# Folder with workflow files (CLI -d overrides this)
WORKFLOWS_DIR=./workflows

# npm start: push files on save / pull once on start
WATCH_ENABLED=false
AUTO_PULL=false
DEBOUNCE_MS=1000
DRY_RUN=false

# Files considered by push/watch/diff
IGNORE_PATTERNS=node_modules/**,*.log,*.tmp,.git/**
INCLUDE_PATTERNS=**/*.json,**/*.yaml,**/*.yml

LOG_LEVEL=info

# Dashboard (npm run gui) - keep on 127.0.0.1, it has no login
GUI_HOST=127.0.0.1
GUI_PORT=3001

# Webhook server (npm start) - WEBHOOK_SECRET is required when enabled
WEBHOOK_ENABLED=false
WEBHOOK_PORT=3000
WEBHOOK_SECRET=
