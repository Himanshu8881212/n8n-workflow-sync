# n8n Configuration
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your-api-key-here

# Workflows Directory (relative to sync-service folder)
WORKFLOWS_DIR=../../Generation Methods

# Sync Configuration
SYNC_INTERVAL_MS=5000
WATCH_ENABLED=true
AUTO_PUSH=true
AUTO_PULL=true
DEBOUNCE_MS=1000
BATCH_SIZE=10
MAX_RETRIES=3
DRY_RUN=false

# Conflict Resolution Strategy
# Options: local_wins, remote_wins, newest_wins
CONFLICT_STRATEGY=newest_wins

# Git Integration (optional)
AUTO_COMMIT=false
COMMIT_MESSAGE_PREFIX=[Auto-Sync]

# Filtering
IGNORE_PATTERNS=node_modules/**,*.log,*.tmp,.git/**
INCLUDE_PATTERNS=**/*.json

# Logging
LOG_LEVEL=info

# Sync State File
SYNC_STATE_FILE=.sync-state.json

