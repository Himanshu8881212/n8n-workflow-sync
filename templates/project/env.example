# Copy to .env (dev) and .env.prod (prod). Never commit the real files.
# API key: n8n → Settings → n8n API → Create API key
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=

# Better: keep N8N_API_KEY and every credential secret (the {{env.NAME}} values in
# flows/credentials.n8n.json) in a secret manager and run commands through it:
#   bws run -- n8n-sync credentials push            # Bitwarden Secrets Manager
#   op run --env-file=.env -- n8n-sync push         # 1Password (op://vault/item/field refs in .env)
WORKFLOWS_DIR=./flows

# Only if webhooks are served from a different host than the API
# N8N_WEBHOOK_URL=https://n8n.example.com
