# Copy to .env (dev) and .env.prod (prod). Never commit the real files.
# API key: n8n → Settings → n8n API → Create API key
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
WORKFLOWS_DIR=./flows

# Only if webhooks are served from a different host than the API
# N8N_WEBHOOK_URL=https://n8n.example.com
