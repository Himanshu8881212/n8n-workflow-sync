{
  "name": "n8n-workflow-sync",
  "version": "2.0.0",
  "description": "Bidirectional auto-sync service for n8n workflows with local Git repository",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "gui": "node src/gui-server.js",
    "prod": "NODE_ENV=production node src/gui-server.js",
    "dev": "nodemon src/index.js",
    "sync:pull": "node src/pull-from-n8n.js",
    "sync:push": "node src/push-to-n8n.js",
    "sync:full": "npm run sync:pull && npm run sync:push",
    "workflows:list": "node src/commands/list-workflows.js",
    "workflows:activate": "node src/commands/activate-workflow.js",
    "workflows:deactivate": "node src/commands/deactivate-workflow.js",
    "workflows:search": "node src/commands/search-workflows.js",
    "version": "node src/commands/version.js"
  },
  "keywords": [
    "n8n",
    "workflow",
    "sync",
    "automation",
    "git",
    "gitops",
    "devops",
    "ci-cd"
  ],
  "author": "SynthEngyne",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "minimatch": "^10.0.1",
    "fast-json-patch": "^3.1.1",
    "js-yaml": "^4.1.0",
    "commander": "^12.0.0",
    "winston": "^3.11.0",
    "p-retry": "^6.2.0",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "c8": "^9.1.0",
    "husky": "^9.0.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}