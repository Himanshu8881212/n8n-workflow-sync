{
  "name": "n8n-workflow-sync",
  "version": "2.0.0",
  "description": "Push local n8n workflow files to n8n (and activate them), pull n8n workflows to files",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "gui": "node src/gui-server.js",
    "prod": "NODE_ENV=production node src/gui-server.js",
    "dev": "nodemon src/index.js",
    "sync:pull": "node src/pull-from-n8n.js",
    "sync:push": "node src/push-to-n8n.js",
    "sync:full": "npm run sync:pull && npm run sync:push",
    "workflows:list": "node src/commands/list-workflows.js",
    "workflows:activate": "node src/commands/activate-workflow.js",
    "workflows:deactivate": "node src/commands/deactivate-workflow.js",
    "workflows:search": "node src/commands/search-workflows.js",
    "workflows:diff": "node src/commands/diff-workflows.js",
    "workflows:prune": "node src/commands/prune-workflows.js",
    "completion": "node src/commands/completion.js",
    "completion:bash": "node src/commands/completion.js bash",
    "completion:zsh": "node src/commands/completion.js zsh",
    "completion:fish": "node src/commands/completion.js fish",
    "version": "node src/commands/version.js",
    "test": "node --test tests/",
    "test:webhook": "node --test tests/webhook-comprehensive.test.js"
  },
  "keywords": [
    "n8n",
    "workflow",
    "sync",
    "automation",
    "git",
    "gitops",
    "devops",
    "ci-cd"
  ],
  "author": "SynthEngyne",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.1",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1",
    "p-queue": "^8.0.1",
    "winston": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "n8n-sync-push": "src/push-to-n8n.js",
    "n8n-sync-pull": "src/pull-from-n8n.js"
  }
}
