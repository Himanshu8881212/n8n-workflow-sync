{
  "name": "n8n-workflow-sync",
  "version": "1.0.0",
  "description": "Bidirectional auto-sync service for n8n workflows with local Git repository",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "watch": "node src/watcher.js",
    "sync:pull": "node src/pull-from-n8n.js",
    "sync:push": "node src/push-to-n8n.js",
    "sync:full": "npm run sync:pull && npm run sync:push",
    "setup": "node src/setup.js",
    "test": "node --test src/**/*.test.js"
  },
  "keywords": [
    "n8n",
    "workflow",
    "sync",
    "automation",
    "git"
  ],
  "author": "SynthEngyne",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "minimatch": "^10.0.1",
    "fast-json-patch": "^3.1.1",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

